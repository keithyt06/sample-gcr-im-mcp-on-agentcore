{
  "name": "sample-gcr-im-mcp-on-agentcore",
  "version": "0.1.0",
  "description": "Deploy a per-user IM MCP server (Feishu, Lark, DingTalk, or WeCom) on Amazon Bedrock AgentCore Runtime in AWS Global or AWS China regions.",
  "license": "MIT-0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "synth": "cdk synth",
    "synth:matrix": "vitest run test/infra/matrix.test.ts",
    "deploy": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force",
    "e2e": "tsx scripts/e2e-smoke.ts",
    "secret:set-im-app": "tsx scripts/secret-set-im-app.ts",
    "mint-test-token": "tsx scripts/mint-test-token.ts",
    "users": "tsx scripts/users.ts",
    "gen:catalog": "tsx scripts/gen-catalog.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-cloudformation": "3.1161.0",
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/client-secrets-manager": "3.1161.0",
    "@aws-sdk/client-ssm": "3.1161.0",
    "@aws-sdk/credential-provider-node": "3.972.92",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.5",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "aws-cdk": "2.1147.0",
    "aws-sdk-client-mock": "4.1.0",
    "cdk-nag": "3.0.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
